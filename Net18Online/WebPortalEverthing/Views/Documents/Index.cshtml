@using WebPortalEverthing.Localizations
@using WebPortalEverthing.Models.Surveys

@{
    Layout = "~/Views/Shared/_LayoutSurveys.cshtml";
}

@model DocumentIndexViewModel

<div class="main-content-title">
    @Surveys.Documents_Index_Name
</div>
<div class="my-2">
    <a class="btn btn-sm btn-success" asp-controller="Documents" asp-action="Create">@Surveys.Add</a>
</div>
<div class="document-page">
    @if (Model.Documents.Any())
    {
        <table class="table table-sm table table-sm table-bordered table-striped">
            <thead>
                <tr>
                    <th scope="col">Название</th>
                    <th scope="col">Оригинальное название файла</th>
                    <th scope="col">Размер, байт</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.Documents)
                {
                    <tr>
                        <td>@document.Title</td>
                        <td>@document.OriginalFileName</td>
                        <td>@document.Length</td>
                        <td>
                            <a href="/files/@document.Url">@Surveys.Open</a>
                            <a href="/Documents/Delete?id=@document.Id">@Surveys.Delete</a>
                        </td>
                    </tr>
                }
        </table>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <span>@Surveys.Documents_Index_Table_Empty</span>
        </div>
    }
</div>