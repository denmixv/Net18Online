@using Enums.Users
@using WebPortalEverthing.Localizations
@using WebPortalEverthing.Services
@inject AuthService AuthService
@inject UserService UserService

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SURVEYS - сервис опросов и тестов</title>
    <link rel="icon" href="~/images/Surveys/letter-s.png">
    <link href="~/css/Bootstrap/bootstrap.css" rel="stylesheet">
    <link href="~/css/icon.css" rel="stylesheet" />
    <link href="~/css/Surveys/reset.css" rel="stylesheet" />
    <link href="~/css/Surveys/style.css" rel="stylesheet" />
    <link href="~/css/Surveys/form.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/cookie.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.js"></script>
    @RenderSection("Scripts", false)
</head>
<body>
    <header class="page-header">
        <div class="logo-and-title">
            <div class="logo">
                <img src="~/images/Surveys/letter-s.png" alt="logo" />
            </div>
            <div class="site-title">
                <div class="site-title-link">
                    surveys
                </div>
                <div class="site-title-name">
                    @Surveys.Surveys_Site_Name
                </div>
            </div>
        </div>
        <div class="profile-block">
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between menu-header">
                <ul class="d-flex">
                    <li class="nav-item m-2">
                        <a class="nav-link text-dark login-link" asp-area="" asp-controller="Surveys" asp-action="Index">@Surveys.Surveys_HomePage</a>
                    </li>
                    @if (!User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item m-2">
                            <a class="nav-link text-dark login-link" asp-area="" asp-controller="SurveysAuth" asp-action="Login">@Surveys.Surveys_Login</a>
                        </li>
                        <li class="nav-item m-2">
                            <a class="nav-link text-dark registration-link" asp-area="" asp-controller="SurveysAuth" asp-action="Register">@Surveys.Surveys_Registration</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item m-2">
                            <a class="nav-link text-dark logout-link" asp-area="" asp-controller="SurveysAuth" asp-action="Logout">@Surveys.Surveys_Logout</a>
                        </li>
                    }
                    <li class="vertical m-2"></li>
                    @if (AuthService.IsAdmin())
                    {
                        <li class="nav-item m-2">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Users">@Surveys.Surveys_Users</a>
                        </li>
                        <li class="nav-item m-2">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Notification" asp-action="Notify">@Surveys.Surveys_Notification</a>
                        </li>
                        <li class="vertical m-2"></li>
                    }
                    @if (AuthService.IsAuthenticated())
                    {
                        <a class="nav-link text-dark m-2" href="/Surveys/UpdateLocale?language=@Language.Ru">Ру</a>
                        <a class="nav-link text-dark m-2" href="/Surveys/UpdateLocale?language=@Language.En">En</a>
                    }
                    else
                    {
                        <a class="nav-link text-dark unauth-lang m-2" href="#" data-lang="@Language.Ru">Ру</a>
                        <a class="nav-link text-dark unauth-lang m-2" href="#" data-lang="@Language.En">En</a>
                    }
                </ul>
            </div>
            @if (AuthService.IsAuthenticated())
            {
                <div>
                    <div class="vertical m-2"></div>
                </div>
                <div>
                    <img class="profile-image" src="@UserService.GetAvatar()" alt="" />
                </div>
                <a href="/Surveys/Profile">
                    <div class="m-2">
                        @AuthService.GetName()
                    </div>
                </a>
            }
        </div>
    </header>
    <div class="menu-and-content">
        <div class="menu-left">
            <ul>
                <li><a class="button" href="/SurveyGroup">@Surveys.Surveys_Menu_Survey_Groups</a></li>
                <li><a class="button" href="/Surveys/SurveysAll">@Surveys.Surveys_Menu_Surveys</a></li>
                <li><a class="button" href="#">@Surveys.Surveys_Menu_Tests</a></li>
                <li><a class="button" href="#">@Surveys.Surveys_Menu_Statistics</a></li>
                @if (AuthService.IsAuthenticated())
                {
                    <li><a class="button" href="/Documents">@Surveys.Surveys_Menu_Documents</a></li>
                }
            </ul>
        </div>
        <div class="main-content">
            @RenderBody()
        </div>
    </div>
    <div class="notification-container">
        <div class="alert alert-primary template" role="alert">
            <span class="text"></span>
        </div>
    </div>
</body>
</html>