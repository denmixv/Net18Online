@using WebPortalEverthing.Localizations
@using WebPortalEverthing.Models.Surveys

@model SurveyGroupCreateViewModel

@{
    Layout = "~/Views/Shared/_LayoutSurveys.cshtml";
}

<div class="main-content-title">
    <span>@Surveys.SurveyGroup_Create_Name</span>
</div>
<form class="new-survey-group" method="post">
    <div>
        <label>
            @Surveys.SurveyGroup_Create_GroupName
            @Html.TextBoxFor(x => x.Title)
            @Html.ValidationMessageFor(x => x.Title)
        </label>
    </div>
    <div class="actions">
        <button class="save-button" type="submit">@Surveys.Save</button>
    </div>
</form>